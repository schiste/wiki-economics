# Toolforge's Rust buildpack reads this legacy configuration file rather than
# rust-toolchain.toml. Keep VERSION synchronized with rust-toolchain.toml.
VERSION=1.98.0
RUST_CARGO_BUILD_FLAGS="--release --locked"

# Production binaries are built and tested by GitHub Actions, then installed
# on Toolforge's shared NFS volume. Avoid recompiling the full Rust dependency
# graph in Toolforge's non-restored build cache. Operators can temporarily set
# WIKI_ECON_BUILD_RUST=1 on a manual build for disaster recovery.
if [ "${WIKI_ECON_BUILD_RUST:-0}" = "1" ]; then
  RUST_SKIP_BUILD=0
else
  RUST_SKIP_BUILD=1
fi
